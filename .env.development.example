# Bloomora — DEVELOPMENT environment template
# Copy to .env.development and fill in real values. .env.development is
# gitignored — never commit it. Ask a teammate for the current dev
# Supabase project ("bloomora") credentials.

APP_ENV=development

API_BASE_URL=https://your-dev-api.example.com/api/v1

SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_ANON_KEY=your-dev-anon-or-publishable-key

GOOGLE_IOS_CLIENT_ID=your-dev-ios-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your-dev-web-client-id.apps.googleusercontent.com

# Monitoring (FT-008) — optional. Sentry DSNs and PostHog project keys are
# designed to be public/client-embeddable (unlike a service role key), so
# they're safe here, same tier as API_BASE_URL/SUPABASE_ANON_KEY above.
# Leave blank in an environment with no monitoring project configured yet —
# ErrorReporter/AnalyticsService treat an empty value as "skip init," not
# an error.
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Do not add an AI provider key here — it is server-only. See backend/.env.example.
