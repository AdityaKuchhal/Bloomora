# Bloomora — PRODUCTION environment template
# Copy to .env.production and fill in real values once production
# infrastructure is provisioned. .env.production is gitignored — never
# commit it. Until then, leave the REPLACE_WITH_* values as-is: the app's
# fail-fast config check treats them as missing required config and shows
# a readable error screen instead of connecting anywhere.

APP_ENV=production

API_BASE_URL=https://REPLACE_WITH_PRODUCTION_API_URL
SUPABASE_URL=https://REPLACE_WITH_PRODUCTION_PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_PRODUCTION_ANON_KEY

GOOGLE_IOS_CLIENT_ID=REPLACE_WITH_PRODUCTION_GOOGLE_IOS_CLIENT_ID
GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_PRODUCTION_GOOGLE_WEB_CLIENT_ID
