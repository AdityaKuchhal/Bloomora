# Bloomora — STAGING environment template
# Copy to .env.staging and fill in real values once staging infrastructure
# is provisioned. .env.staging is gitignored — never commit it.
# Until then, leave the REPLACE_WITH_* values as-is: the app's fail-fast
# config check treats them as missing required config and shows a readable
# error screen instead of connecting anywhere.

APP_ENV=staging

API_BASE_URL=https://REPLACE_WITH_STAGING_API_URL
SUPABASE_URL=https://REPLACE_WITH_STAGING_PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_STAGING_ANON_KEY

GOOGLE_IOS_CLIENT_ID=REPLACE_WITH_STAGING_GOOGLE_IOS_CLIENT_ID
GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_STAGING_GOOGLE_WEB_CLIENT_ID

# Monitoring (FT-008) — optional, not in the fail-fast required-config
# check. Leave blank until a staging Sentry/PostHog project exists.
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
