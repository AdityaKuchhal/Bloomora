# Bloomora backend — environment template
# Copy to backend/.env and fill in real values. backend/.env is gitignored
# — never commit it.

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
# NOTE: the codebase reads SUPABASE_SERVICE_KEY (see src/middleware/auth.js,
# src/routes/children.js). This is a deviation from the naming used in the
# planning docs (SUPABASE_SERVICE_ROLE_KEY) — documented here rather than
# renamed, since renaming is a code change out of FT-001's scope. Never
# expose this value to the Flutter app.
SUPABASE_SERVICE_KEY=your_supabase_service_key

# AI Provider (Anthropic — confirmed provider, see docs/audit-findings.md).
# Server-only. Never add this to the Flutter app's .env.<environment> files.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS) — read by src/app.js
FRONTEND_URL=http://localhost:3000

# CORS — additional allowed origins beyond FRONTEND_URL, comma-separated
# (not yet wired into src/app.js; documented here per the planning docs'
# env var list for when CORS handling is built out)
CORS_ALLOWED_ORIGINS=

# Rate Limiting
# NOTE: not currently read by src/app.js (rate limiting is hardcoded there
# today) — documented here for when it's wired up. Name kept as
# RATE_LIMIT_MAX_REQUESTS (not the planning docs' RATE_LIMIT_MAX) since
# neither name has a code reader yet; whichever is wired up first should
# become canonical.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Error tracking (FT-008)
SENTRY_DSN=

# Release identifier for Sentry event tagging — optional, falls back to
# package.json's version field if both are absent. RELEASE_SHA (a deploy-
# time git SHA a CI/CD pipeline would inject) is preferred over APP_VERSION
# when both are present.
RELEASE_SHA=
APP_VERSION=
